{% extends 'site/base.html.twig' %}

{% block body_class %}site-layout wp-landing{% endblock %}

{% block title %}{{ page_title }}{% endblock %}
{% block meta_description %}{{ meta_description }}{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ canonical_path }}">{% endblock %}

{% block structured_data %}
    {% set site_origin = app.request.schemeAndHttpHost %}
    {% set page_url = site_origin ~ app.request.pathInfo %}
    {% set org_name = 'footer.wp_brand'|trans({}, 'site') %}
    {% set logo_url = absolute_url(asset('images/smyalichi-landmark-logo.png')) %}
    {% set page_title = block('title') %}
    {% set page_description = block('meta_description') %}
    {% set in_lang = app.request.locale == 'en' ? 'en' : 'ru' %}
    {% set publisher_ref = { '@id': site_origin ~ '/#organization' } %}
    {% set post1_article_url = absolute_url(path('site_blog_post_monitoring.' ~ (in_lang == 'en' ? 'en' : 'ru'))) %}
    {% set post2_article_url = absolute_url(path('site_blog_post_kpi_metrics.' ~ (in_lang == 'en' ? 'en' : 'ru'))) %}
    {% set item_list = [
        { '@type': 'ListItem', 'position': 1, 'item': { '@type': 'BlogPosting', 'headline': 'blog.post1_title'|trans({}, 'site'), 'description': 'blog.post1_text'|trans({}, 'site'), 'url': post1_article_url, 'inLanguage': in_lang, 'publisher': publisher_ref } },
        { '@type': 'ListItem', 'position': 2, 'item': { '@type': 'BlogPosting', 'headline': 'blog.post2_title'|trans({}, 'site'), 'description': 'blog.post2_text'|trans({}, 'site'), 'url': post2_article_url, 'inLanguage': in_lang, 'publisher': publisher_ref } },
        { '@type': 'ListItem', 'position': 3, 'item': { '@type': 'BlogPosting', 'headline': 'blog.post3_title'|trans({}, 'site'), 'description': 'blog.post3_text'|trans({}, 'site'), 'url': page_url ~ '#blog-post-3', 'inLanguage': in_lang, 'publisher': publisher_ref } }
    ] %}
    {% set schema_graph = site_ld_graph(
        'collection',
        site_origin,
        page_url,
        app.request.locale,
        org_name,
        logo_url,
        page_title,
        page_description,
        { items: item_list }
    ) %}
    {% include 'site/_json_ld.html.twig' with { graph: schema_graph } %}
{% endblock %}

{% block site_content %}
<section class="sl-inner-hero sl-inner-hero--wp">
    <div class="sl-hero__deco-lines" aria-hidden="true"></div>
    <div class="container">
        <span class="sl-chip sl-chip--wp">{{ 'blog.chip'|trans({}, 'site') }}</span>
        <h1 class="sl-inner-hero__title-two-lines">
            <span>{{ 'blog.hero_title_l1'|trans({}, 'site') }}</span>
            <span>{{ 'blog.hero_title_l2'|trans({}, 'site') }}</span>
        </h1>
        <p>{{ 'blog.hero_lead'|trans({}, 'site') }}</p>
    </div>
</section>

<section class="sl-inner-section sl-inner-section--wp">
    <div class="container">
        <div class="sl-post-grid sl-post-grid--wp">
            <article id="blog-post-1" class="sl-post-card sl-post-card--wp">
                <span>{{ 'blog.post1_tag'|trans({}, 'site') }}</span>
                {% set post1_href = path('site_blog_post_monitoring.' ~ (app.request.locale == 'en' ? 'en' : 'ru')) %}
                <h2><a class="sl-post-card__title-link" href="{{ post1_href }}">{{ 'blog.post1_title'|trans({}, 'site') }}</a></h2>
                <p>{{ 'blog.post1_text'|trans({}, 'site') }}</p>
                <p class="sl-post-card__readmore"><a class="sl-wp-text-link" href="{{ post1_href }}">{{ 'blog.read_article'|trans({}, 'site') }} {% include 'site/_icon.html.twig' with { name: 'arrow-right' } %}</a></p>
            </article>
            <article id="blog-post-2" class="sl-post-card sl-post-card--wp sl-post-card--wp-accent">
                <span>{{ 'blog.post2_tag'|trans({}, 'site') }}</span>
                {% set post2_href = path('site_blog_post_kpi_metrics.' ~ (app.request.locale == 'en' ? 'en' : 'ru')) %}
                <h2><a class="sl-post-card__title-link" href="{{ post2_href }}">{{ 'blog.post2_title'|trans({}, 'site') }}</a></h2>
                <p>{{ 'blog.post2_text'|trans({}, 'site') }}</p>
                <p class="sl-post-card__readmore"><a class="sl-wp-text-link" href="{{ post2_href }}">{{ 'blog.read_article'|trans({}, 'site') }} {% include 'site/_icon.html.twig' with { name: 'arrow-right' } %}</a></p>
            </article>
            <article id="blog-post-3" class="sl-post-card sl-post-card--wp">
                <span>{{ 'blog.post3_tag'|trans({}, 'site') }}</span>
                {% include 'site/_wp_heading_with_underline.html.twig' with { title: 'blog.post3_title'|trans({}, 'site') } %}
                <p>{{ 'blog.post3_text'|trans({}, 'site') }}</p>
            </article>
        </div>
    </div>
</section>
{% endblock %}
